# Algolia Configuration
# Copy this file to .env and fill in your actual values
# 
# IMPORTANT: Use a SEARCH-ONLY API key for client-side applications.
# Search-only keys are safe to expose in the browser.
# Never use Admin API keys in client-side code.

ALGOLIA_APP_ID=your_app_id_here
ALGOLIA_SEARCH_API_KEY=your_search_only_api_key_here
ALGOLIA_INDEX_NAME=your_index_name_here
